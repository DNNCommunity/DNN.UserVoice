<?xml version="1.0" encoding="utf-8"?>
<dotnetnuke version="5.0" type="Package">
  <packages>
    <package name="DNNCommunity_UserVoice" type="Module" version="00.02.00">
      <friendlyName>User Voice Module</friendlyName>
      <description>User Voice Module</description>
      <iconFile>~/DesktopModules/Dnn.UserVoice/resources/images/module-icon.png</iconFile>
      <owner>
        <name>DNN Community</name>
        <organization>DNN Community</organization>
        <url>https://dnncommunity.org</url>
        <email>info@dnncommunity.org</email>
      </owner>
      <license src="LICENSE">
      </license>
      <releaseNotes src="ReleaseNotes.html" />
      <azureCompatible>True</azureCompatible>
      <dependencies>
        <dependency type="coreVersion">10.02.01</dependency>
      </dependencies>
      <components>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>DNN.Modules.UserVoice.dll</name>
              <path>bin</path>
            </assembly>
            <assembly>
              <name>EntityFramework.dll</name>
              <path>bin</path>
              <version>6.500.124</version>
            </assembly>
            <assembly>
              <name>EntityFramework.SqlServer.dll</name>
              <path>bin</path>
              <version>6.500.124</version>
            </assembly>
            <assembly>
              <name>NSwag.Annotations.dll</name>
              <path>bin</path>
              <version>14.6.3</version>
            </assembly>
            <assembly>
              <name>FluentValidation.dll</name>
              <path>bin</path>
              <version>11.12.0</version>
            </assembly>
            <assembly>
              <name>System.Threading.Tasks.Extensions.dll</name>
              <path>bin</path>
              <version>4.6.28619</version>
            </assembly>
            <assembly>
              <name>System.Runtime.CompilerServices.Unsafe.dll</name>
              <path>bin</path>
              <version>4.6.28619</version>
            </assembly>
            <assembly>
              <name>OneOf.dll</name>
              <path>bin</path>
              <version>1.0.0</version>
            </assembly>
          </assemblies>
        </component>
        <component type="Module">
          <desktopModule>
            <moduleName>User Voice Module</moduleName>
            <foldername>Dnn.UserVoice</foldername>
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>User Voice Module</friendlyName>
                <defaultCacheTime>0</defaultCacheTime>
                <moduleControls>
                  <moduleControl>
                    <controlKey />
                    <controlSrc>DesktopModules/Dnn.UserVoice/resources/views/view.html</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle />
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl />
                    <viewOrder>0</viewOrder>
                  </moduleControl>
                </moduleControls>
              </moduleDefinition>
            </moduleDefinitions>
          </desktopModule>
        </component>
        <component type="Cleanup" version="00.02.00" glob="DesktopModules/Dnn.UserVoice/resources/**/*" />
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/Dnn.UserVoice/resources</basePath>
            <resourceFile>
              <name>resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>bin</basePath>
            <resourceFile>
              <name>symbols.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>